    "@nuxt/fonts": "0.12.1",
    "@nuxt/hints": "1.0.0-alpha.3",
    "@nuxt/image": "^2.0.0",
    "@nuxt/scripts": "0.13.1",
    "@nuxt/ui": "^4.8.0",
    "@nuxtjs/seo": "3.3.0",
    "@standard-schema/spec": "^1.1.0",
    "@unhead/vue": "^2.1.15",
    "@vueuse/nuxt": "^14.3.0",
